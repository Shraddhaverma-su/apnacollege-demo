        "# ============================================\n",
        "# STOCK PRICE PREDICTOR\n",
        "# Machine Learning Project\n",
        "# ============================================\n",
        "\n",
        "# Install required libraries\n",
        "!pip install yfinance scikit-learn matplotlib pandas numpy -q\n",
        "\n",
        "# Import libraries\n",
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 1. DOWNLOAD STOCK DATA\n",
        "# ============================================\n",
        "\n",
        "# Example: Apple stock\n",
        "ticker = \"AAPL\"\n",
        "\n",
        "data = yf.download(\n",
        "    ticker,\n",
        "    start=\"2018-01-01\",\n",
        "    end=\"2026-01-01\",\n",
        "    auto_adjust=False\n",
        ")\n",
        "\n",
        "print(\"First 5 rows:\")\n",
        "print(data.head())\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 2. PREPARE DATA\n",
        "# ============================================\n",
        "\n",
        "# Select Close price\n",
        "close_data = data[[\"Close\"]].copy()\n",
        "\n",
        "# Convert to simple column\n",
        "close_data.columns = [\"Close\"]\n",
        "\n",
        "# Remove missing values\n",
        "close_data.dropna(inplace=True)\n",
        "\n",
        "print(\"\\nTotal records:\", len(close_data))\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 3. CREATE FEATURES\n",
        "# ============================================\n",
        "\n",
        "# Previous day's closing price\n",
        "close_data[\"Previous_Close\"] = close_data[\"Close\"].shift(1)\n",
        "\n",
        "# 5-day moving average\n",
        "close_data[\"MA_5\"] = close_data[\"Close\"].rolling(window=5).mean()\n",
        "\n",
        "# 10-day moving average\n",
        "close_data[\"MA_10\"] = close_data[\"Close\"].rolling(window=10).mean()\n",
        "\n",
        "# Remove rows containing NaN\n",
        "close_data.dropna(inplace=True)\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 4. CREATE TARGET\n",
        "# ============================================\n",
        "\n",
        "# Tomorrow's closing price\n",
        "close_data[\"Tomorrow_Close\"] = close_data[\"Close\"].shift(-1)\n",
        "\n",
        "close_data.dropna(inplace=True)\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 5. SELECT FEATURES AND TARGET\n",
        "# ============================================\n",
        "\n",
        "X = close_data[\n",
        "    [\"Previous_Close\", \"MA_5\", \"MA_10\"]\n",
        "]\n",
        "\n",
        "y = close_data[\"Tomorrow_Close\"]\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 6. SPLIT DATA INTO TRAINING AND TESTING\n",
        "# ============================================\n",
        "\n",
        "# Important: shuffle=False because stock data is time-series data\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.2,\n",
        "    shuffle=False\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 7. TRAIN MACHINE LEARNING MODEL\n",
        "# ============================================\n",
        "\n",
        "model = LinearRegression()\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "print(\"\\nModel training completed!\")\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 8. PREDICT TEST DATA\n",
        "# ============================================\n",
        "\n",
        "predictions = model.predict(X_test)\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 9. CHECK MODEL PERFORMANCE\n",
        "# ============================================\n",
        "\n",
        "mae = mean_absolute_error(y_test, predictions)\n",
        "rmse = np.sqrt(mean_squared_error(y_test, predictions))\n",
        "r2 = r2_score(y_test, predictions)\n",
        "\n",
        "print(\"\\n----- MODEL PERFORMANCE -----\")\n",
        "print(\"MAE :\", round(mae, 2))\n",
        "print(\"RMSE:\", round(rmse, 2))\n",
        "print(\"R² Score:\", round(r2, 4))\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 10. PLOT ACTUAL VS PREDICTED PRICE\n",
        "# ============================================\n",
        "\n",
        "plt.figure(figsize=(14, 6))\n",
        "\n",
        "plt.plot(\n",
        "    y_test.values,\n",
        "    label=\"Actual Price\",\n",
        "    color=\"blue\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    predictions,\n",
        "    label=\"Predicted Price\",\n",
        "    color=\"red\"\n",
        ")\n",
        "\n",
        "plt.title(\"Stock Price Prediction\")\n",
        "plt.xlabel(\"Days\")\n",
        "plt.ylabel(\"Stock Price\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================\n",
        "# 11. PREDICT NEXT DAY PRICE\n",
        "# ============================================\n",
        "\n",
        "latest_data = close_data.iloc[-1]\n",
        "\n",
        "previous_close = latest_data[\"Close\"]\n",
        "ma_5 = close_data[\"Close\"].tail(5).mean()\n",
        "ma_10 = close_data[\"Close\"].tail(10).mean()\n",
        "\n",
        "next_day_features = np.array([\n",
        "    [previous_close, ma_5, ma_10]\n",
        "])\n",
        "\n",
        "next_day_prediction = model.predict(\n",
        "    next_day_features\n",
        ")[0]\n",
        "\n",
        "print(\"\\n================================\")\n",
        "print(\"NEXT DAY STOCK PRICE PREDICTION\")\n",
        "print(\"================================\")\n",
        "\n",
        "print(\"Stock:\", ticker)\n",
        "print(\"Last Closing Price:\",\n",
        "      round(float(previous_close), 2))\n",
        "\n",
        "print(\"Predicted Next Day Price:\",\n",
        "      round(float(next_day_prediction), 2))\n",
        "\n",
        "print(\"================================\")"
      ]
    }
